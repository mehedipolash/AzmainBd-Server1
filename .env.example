# Template for new developers. Copy to .env and fill in real values.
#   cp .env.example .env
#
# Everything in this file is server-side only and NEVER reaches the browser.
# This is where secrets belong: the Mongo credentials, and later the Firebase
# admin key, SSLCommerz store password, and JWT secret.

# MongoDB Atlas credentials (used to build the connection string in index.js)
DB_USER=your-db-user
DB_PASS=your-db-password

# Port the Express server listens on. The client's VITE_API_BASE_URL must match.
PORT=5000
