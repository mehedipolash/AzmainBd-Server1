# Copy to .env and fill in. .env is gitignored — never commit real values.

# MongoDB Atlas credentials
DB_USER=your-db-user
DB_PASS=your-db-password
DB_NAME=AzmainBd

# The Atlas cluster host — the "cluster0.xxxxx.mongodb.net" part of your
# connection string (Atlas > Connect > Drivers). Change this (not any code)
# when moving to a different MongoDB account.
DB_HOST=cluster0.xxxxx.mongodb.net

# Firebase project id — used to validate the issuer and audience of incoming
# ID tokens. This is not a secret; it is the same value the client uses.
# No service account key is needed: tokens are verified against Google's
# public keys.
FIREBASE_PROJECT_ID=azmainbd-cc55e

# Browser origins allowed to call this API. Comma-separated, no trailing slash.
# 5173 is `vite dev`, 5174 a second dev port, 4173 is `vite preview`.
#
# PRODUCTION (cPanel): set this to the live site's https origin, e.g.
#   ALLOWED_ORIGINS=https://azmain.com.bd
# The server REFUSES to boot in production if this is still localhost-only or
# uses plain http (see config/env.js) — a deliberate safety net.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# Emails that become admin on first sign-in. Comma-separated, max 3 in production.
# After the first admin exists, further roles are granted from the admin panel.
#   PRODUCTION example: ADMIN_EMAILS=owner@example.com,dev@example.com
ADMIN_EMAILS=your-email@example.com

# PORT — leave UNSET on cPanel. The Node.js App manager injects its own port;
# a hardcoded value here would be ignored at best and clash at worst.
PORT=5000

# NODE_ENV — MUST be "production" on the live server. It switches on the
# production safety checks in config/env.js and silences verbose error logs.
NODE_ENV=development
